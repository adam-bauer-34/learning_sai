Cell[CellGroupData[{
Cell["2-Layer TLM and ADJ Formulation", "Title",
 CellChangeTimes->{{3.929622502799564*^9, 
  3.9296225074206057`*^9}},ExpressionUUID->"5e30ce1b-b5d2-4533-900b-\
ede8f8b98c7b"],

Cell[TextData[{
 "This is for ",
 StyleBox["just",
  FontSlant->"Italic"],
 " state estimation -- that is, just the initial conditions of the two \
temperature layers."
}], "Text",
 CellChangeTimes->{{3.930848596420306*^9, 
  3.930848608916588*^9}},ExpressionUUID->"3b4e4be3-4d10-436b-b722-\
6d33c1597615"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Ft", "=", 
   RowBox[{
    RowBox[{"F1", "*", 
     RowBox[{"Log", "[", 
      FractionBox["Ct", "CCO2"], "]"}]}], "+", 
    RowBox[{"F3", "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Sqrt", "[", "Ct", "]"}], "-", 
       RowBox[{"Sqrt", "[", "CCO2", "]"}]}], ")"}]}], "+", 
    RowBox[{"aSO2", "*", "ESO2t"}], "+", 
    RowBox[{"bSO2", "*", 
     RowBox[{"Log", "[", 
      RowBox[{"1", "+", 
       FractionBox["ESO2t", "CSO2"]}], "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"T1next", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        FractionBox["dt", "C1"], "*", 
        RowBox[{"(", 
         RowBox[{"\[Lambda]", "+", "\[Gamma]"}], ")"}]}]}], ")"}], "*", 
     "T1"}], "+", 
    RowBox[{
     FractionBox[
      RowBox[{"dt", "*", "\[Gamma]"}], "C1"], "*", "T2"}], "+", 
    RowBox[{
     FractionBox["dt", "C1"], "*", "Ft"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"T2next", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       FractionBox[
        RowBox[{"dt", "*", "\[Gamma]"}], "C2"]}], ")"}], "*", "T2"}], "+", 
    RowBox[{
     FractionBox[
      RowBox[{"dt", "*", "\[Gamma]"}], "C2"], "*", "T1"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"TwoLayerRHS", "=", 
  RowBox[{"{", 
   RowBox[{"T1next", ",", " ", "T2next"}], "}"}]}]}], "Input",
 CellChangeTimes->{{3.929622536317807*^9, 3.9296227687233553`*^9}, {
  3.929623215085435*^9, 3.929623215372704*^9}, {3.929637030933576*^9, 
  3.929637060856065*^9}, {3.930656558259503*^9, 3.930656559869031*^9}, {
