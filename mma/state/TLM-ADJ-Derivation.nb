  3.9306569705038137`*^9}, {3.930848557841674*^9, 3.9308485580488367`*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"bb3a5ee2-e198-48b7-8921-4a4479e1d765"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{"dt", " ", "T2", " ", "\[Gamma]"}], "C1"], "+", 
    RowBox[{"T1", " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       FractionBox[
        RowBox[{"dt", " ", 
         RowBox[{"(", 
          RowBox[{"\[Gamma]", "+", "\[Lambda]"}], ")"}]}], "C1"]}], ")"}]}], 
    "+", 
    FractionBox[
     RowBox[{"dt", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"aSO2", " ", "ESO2t"}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            SqrtBox["CCO2"]}], "+", 
           SqrtBox["Ct"]}], ")"}], " ", "F3"}], "+", 
        RowBox[{"F1", " ", 
         RowBox[{"Log", "[", 
          FractionBox["Ct", "CCO2"], "]"}]}], "+", 
        RowBox[{"bSO2", " ", 
         RowBox[{"Log", "[", 
          RowBox[{"1", "+", 
           FractionBox["ESO2t", "CSO2"]}], "]"}]}]}], ")"}]}], "C1"]}], ",", 
   RowBox[{
    FractionBox[
     RowBox[{"dt", " ", "T1", " ", "\[Gamma]"}], "C2"], "+", 
    RowBox[{"T2", " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       FractionBox[
        RowBox[{"dt", " ", "\[Gamma]"}], "C2"]}], ")"}]}]}]}], 
  "}"}]], "Output",
 CellChangeTimes->{
