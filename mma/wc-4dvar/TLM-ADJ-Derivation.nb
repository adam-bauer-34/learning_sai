Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", 
   TagBox[GridBox[{
      {
       RowBox[{
        FractionBox[
         RowBox[{"dt", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "ErefSO2"}], "+", "ESO2t"}], ")"}], " ", 
          "\[Delta]aSO2"}], "C1"], "-", 
        FractionBox[
         RowBox[{"bSO2", " ", "dt", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "ErefSO2"}], "+", "ESO2t"}], ")"}], " ", 
          "\[Delta]CSO2"}], 
         RowBox[{"C1", " ", 
          SuperscriptBox["CSO2", "2"], " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            FractionBox[
             RowBox[{
              RowBox[{"-", "ErefSO2"}], "+", "ESO2t"}], "CSO2"]}], ")"}]}]], 
        "+", 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             SqrtBox["CCO2"]}], "+", 
            SqrtBox["Ct"]}], ")"}], " ", "dt", " ", "\[Delta]F3"}], "C1"], 
        "+", 
        FractionBox[
         RowBox[{"dt", " ", "\[Gamma]", " ", "\[Delta]T2"}], "C1"], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            FractionBox[
             RowBox[{"dt", " ", "T1"}], "C1"]}], "+", 
           FractionBox[
            RowBox[{"dt", " ", "T2"}], "C1"]}], ")"}], " ", 
         "\[Delta]\[Gamma]"}], "-", 
        FractionBox[
         RowBox[{"dt", " ", "T1", " ", "\[Delta]\[Lambda]"}], "C1"], "+", 
        RowBox[{"\[Delta]T1", " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           FractionBox[
            RowBox[{"dt", " ", 
             RowBox[{"(", 
              RowBox[{"\[Gamma]", "+", "\[Lambda]"}], ")"}]}], "C1"]}], 
          ")"}]}], "+", 
        FractionBox[
         RowBox[{"dt", " ", "\[Delta]F1", " ", 
          RowBox[{"Log", "[", 
           FractionBox["Ct", "CCO2"], "]"}]}], "C1"], "+", 
        FractionBox[
         RowBox[{"dt", " ", "\[Delta]bSO2", " ", 
          RowBox[{"Log", "[", 
           RowBox[{"1", "+", 
            FractionBox[
             RowBox[{
              RowBox[{"-", "ErefSO2"}], "+", "ESO2t"}], "CSO2"]}], "]"}]}], 
         "C1"], "+", 
        RowBox[{"\[Delta]C1", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            FractionBox[
             RowBox[{"dt", " ", "T2", " ", "\[Gamma]"}], 
             SuperscriptBox["C1", "2"]]}], "+", 
           FractionBox[
            RowBox[{"dt", " ", "T1", " ", 
             RowBox[{"(", 
              RowBox[{"\[Gamma]", "+", "\[Lambda]"}], ")"}]}], 
            SuperscriptBox["C1", "2"]], "-", 
           FractionBox[
            RowBox[{"dt", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"aSO2", " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", "ErefSO2"}], "+", "ESO2t"}], ")"}]}], "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", 
                   SqrtBox["CCO2"]}], "+", 
                  SqrtBox["Ct"]}], ")"}], " ", "F3"}], "+", 
               RowBox[{"F1", " ", 
                RowBox[{"Log", "[", 
                 FractionBox["Ct", "CCO2"], "]"}]}], "+", 
               RowBox[{"bSO2", " ", 
                RowBox[{"Log", "[", 
                 RowBox[{"1", "+", 
                  FractionBox[
                   RowBox[{
                    RowBox[{"-", "ErefSO2"}], "+", "ESO2t"}], "CSO2"]}], 
                 "]"}]}]}], ")"}]}], 
            SuperscriptBox["C1", "2"]]}], ")"}]}]}]},
      {
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            FractionBox[
             RowBox[{"dt", " ", "T1", " ", "\[Gamma]"}], 
             SuperscriptBox["C2", "2"]]}], "+", 
           FractionBox[
            RowBox[{"dt", " ", "T2", " ", "\[Gamma]"}], 
            SuperscriptBox["C2", "2"]]}], ")"}], " ", "\[Delta]C2"}], "+", 
        FractionBox[
         RowBox[{"dt", " ", "\[Gamma]", " ", "\[Delta]T1"}], "C2"], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", 
           FractionBox[
            RowBox[{"dt", " ", "\[Gamma]"}], "C2"]}], ")"}], " ", 
         "\[Delta]T2"}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           FractionBox[
            RowBox[{"dt", " ", "T1"}], "C2"], "-", 
           FractionBox[
            RowBox[{"dt", " ", "T2"}], "C2"]}], ")"}], " ", 
         "\[Delta]\[Gamma]"}]}]},
      {
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "dt"}], " ", "ErefSO2"}], "+", 
           RowBox[{"dt", " ", "ESO2t"}]}], ")"}], " ", "\[Delta]aSO2"}], "+", 
        
        RowBox[{"T1", " ", "\[Delta]C1"}], "+", 
        RowBox[{"T2", " ", "\[Delta]C2"}], "+", 
        FractionBox[
         RowBox[{"bSO2", " ", "CSO2", " ", "dt", " ", 
          RowBox[{"(", 
           RowBox[{
            FractionBox["1", "CSO2"], "-", 
            FractionBox[
             RowBox[{"CSO2", "-", "ErefSO2", "+", "ESO2t"}], 
             SuperscriptBox["CSO2", "2"]]}], ")"}], " ", "\[Delta]CSO2"}], 
         RowBox[{"CSO2", "-", "ErefSO2", "+", "ESO2t"}]], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             SqrtBox["CCO2"]}], " ", "dt"}], "+", 
           RowBox[{
            SqrtBox["Ct"], " ", "dt"}]}], ")"}], " ", "\[Delta]F3"}], "+", 
        RowBox[{"C2", " ", "\[Delta]T2"}], "-", 
        RowBox[{"dt", " ", "T1", " ", "\[Delta]\[Lambda]"}], "+", 
        RowBox[{"\[Delta]T1", " ", 
         RowBox[{"(", 
          RowBox[{"C1", "-", 
           RowBox[{"dt", " ", "\[Lambda]"}]}], ")"}]}], "+", 
        RowBox[{"dt", " ", "\[Delta]F1", " ", 
         RowBox[{"Log", "[", 
          FractionBox["Ct", "CCO2"], "]"}]}], "+", 
        RowBox[{"dt", " ", "\[Delta]bSO2", " ", 
         RowBox[{"Log", "[", 
          FractionBox[
           RowBox[{"CSO2", "-", "ErefSO2", "+", "ESO2t"}], "CSO2"], "]"}]}]}]},
      {"\[Delta]\[Lambda]"},
      {"\[Delta]\[Gamma]"},
      {"\[Delta]C1"},
      {"\[Delta]C2"},
      {"\[Delta]F1"},
      {"\[Delta]F3"},
      {"\[Delta]aSO2"},
      {"\[Delta]bSO2"},
