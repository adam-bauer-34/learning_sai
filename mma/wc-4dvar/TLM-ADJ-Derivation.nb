     "\[Delta]C2", ",", "\[Delta]F1", ",", "\[Delta]F3", ",", "\[Delta]aSO2", 
     ",", "\[Delta]bSO2", ",", "\[Delta]CSO2"}], "}"}]}], "]"}]], "Input",
